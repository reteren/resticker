{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "resticker",
  "version": "0.1.0",
  "identifier": "dev.resticker.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "resticker — настройки",
        "width": 900,
        "height": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
