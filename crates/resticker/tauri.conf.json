{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "resticker",
  "version": "0.1.0",
  "identifier": "dev.resticker.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "resticker — settings",
        "width": 900,
        "height": 600,
        "visible": false,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "theme": "dark",
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        }
      },
      {
        "label": "traymenu",
        "url": "traymenu.html",
        "title": "resticker menu",
        "width": 232,
        "height": 240,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "theme": "dark",
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/ffmpeg-dlls/*.dll": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
