{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the settings window: close, drag by the custom titlebar, file dialogs",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open"
  ]
}
